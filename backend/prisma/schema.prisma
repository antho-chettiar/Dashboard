generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artist {
  id                      String                @id @default(dbgenerated("gen_random_uuid()"))
  artistName              String                @unique
  displayName             String?
  age                     Int?
  gender                  String?
  genre                   String?
  nationality             String?
  bio                     String?
  photoUrl                String?
  wikiUrl                 String?
  active                  Boolean               @default(true)
  instagramUrl            String?
  facebookUrl             String?
  twitterUrl              String?
  spotifyUrl              String?
  youtubeUrl              String?
  appleMusicUrl           String?
  instagramFollowers      Int?
  facebookFollowers       Int?
  twitterFollowers        Int?
  spotifyMonthlyListeners Int?
  youtubeSubscribers      Int?
  appleMusicListeners     Int?
  lastUpdated             DateTime?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  genres                  ArtistGenre[]
  audienceDemographics    AudienceDemographic[]
  concerts                Concert[]
  platformMetrics         PlatformMetric[]

  @@index([active])
  @@index([artistName])
  @@map("artists")
}

model Genre {
  id         String        @id @default(cuid())
  name       String        @unique
  created_at DateTime      @default(now())
  artists    ArtistGenre[]

  @@map("genres")
}

model ArtistGenre {
  artistId String
  genreId  String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@map("artist_genres")
}

model PlatformMetric {
  id          String       @id @default(cuid())
  artistId    String
  platform    Platform
  metricDate  DateTime     @db.Date
  followers   Int          @default(0)
  likes       Int          @default(0)
  shares      Int          @default(0)
  comments    Int          @default(0)
  streams     Int          @default(0)
  rogDaily    Float?
  rogWeekly   Float?
  rogMonthly  Float?
  source      MetricSource @default(API)
  rawSnapshot Json?
  created_at  DateTime     @default(now())
  artist      Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, platform, metricDate])
  @@index([artistId, platform, metricDate])
  @@index([metricDate])
  @@map("platform_metrics")
}

model Concert {
  id                   String                @id @default(cuid())
  artistId             String
  concertName          String?
  concertDate          DateTime              @db.Date
  city                 String
  state                String?
  country              String
  latitude             Float?
  longitude            Float?
  venueName            String?
  capacity             Int?
  ticketsSold          Int                   @default(0)
  avgTicketPrice       Float?
  totalRevenue         Float?
  currency             String                @default("INR")
  notes                String?
  created_at           DateTime              @default(now())
  audienceDemographics AudienceDemographic[]
  artist               Artist                @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, concertDate])
  @@index([city])
  @@index([country])
  @@map("concerts")
}

model AudienceDemographic {
  id             String               @id @default(cuid())
  artistId       String?
  concertId      String?
  dimension      DemographicDimension
  dimensionValue String               @db.VarChar(100)
  percentage     Float?
  absoluteCount  Int?
  sourcePlatform String?              @db.VarChar(100)
  metricDate     DateTime             @db.Date
  created_at     DateTime             @default(now())
  artist         Artist?              @relation(fields: [artistId], references: [id])
  concert        Concert?             @relation(fields: [concertId], references: [id])

  @@index([artistId])
  @@index([concertId])
  @@index([dimension])
  @@map("audience_demographics")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(VIEWER)
  active        Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  YOUTUBE
  SPOTIFY
  APPLE_MUSIC
  REDDIT
  QUORA
}

enum MetricSource {
  API
  EXCEL_IMPORT
}

enum DemographicDimension {
  AGE_GROUP
  GENDER
  GEOGRAPHY
  GENRE
}

enum UserRole {
  ADMIN
  VIEWER
}
